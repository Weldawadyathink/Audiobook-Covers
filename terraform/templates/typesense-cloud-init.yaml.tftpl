#cloud-config
package_update: true
package_upgrade: true

bootcmd:
  - mkdir -p /etc/typesense /var/lib/typesense /etc/systemd/system/typesense-server.service.d

packages:
  - ca-certificates
  - curl
  - gnupg

runcmd:
  - |
    set -eu

    curl -fsSL "https://dl.typesense.org/releases/${typesense_version}/typesense-server-${typesense_version}-amd64.deb" -o /tmp/typesense-server.deb
    apt-get install -y /tmp/typesense-server.deb
    rm -f /tmp/typesense-server.deb
    systemctl stop typesense-server || true

    install -d -m 0755 /etc/typesense /var/lib/typesense /etc/systemd/system/typesense-server.service.d

    printf '%s' '${origin_certificate_pem_b64}' | base64 -d >/etc/typesense/cloudflare-origin.pem
    printf '%s' '${origin_private_key_pem_b64}' | base64 -d >/etc/typesense/cloudflare-origin.key
    printf '%s' '${typesense_config_b64}' | base64 -d >/etc/typesense/typesense-server.ini
    printf '%s' '${systemd_override_b64}' | base64 -d >/etc/systemd/system/typesense-server.service.d/override.conf

    chown -R typesense-server:typesense-server /var/lib/typesense
    chown typesense-server:typesense-server /etc/typesense/typesense-server.ini /etc/typesense/cloudflare-origin.pem /etc/typesense/cloudflare-origin.key
    chmod 0640 /etc/typesense/typesense-server.ini
    chmod 0644 /etc/typesense/cloudflare-origin.pem
    chmod 0600 /etc/typesense/cloudflare-origin.key

    systemctl daemon-reload
    systemctl enable --now typesense-server

    curl -fsSL https://tailscale.com/install.sh | sh
    tailscale up --auth-key="${tailscale_auth_key}" --ssh --hostname="${droplet_name}" ${tailscale_tags_arg}
